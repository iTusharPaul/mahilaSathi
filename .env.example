# =================================================================
# NightWise Configuration
# =================================================================

# Nexconn Chat SDK credentials
# Obtain from https://console.nexconn.ai/agile/apps/km
NEXCONN_APP_KEY=
VITE_NEXCONN_APP_KEY=
# SERVER ONLY. Never expose in client bundles, never commit to git.
NEXCONN_APP_SECRET=

# Geoapify API Key
# Used for Geocoding, Routing alternatives, Places API along route
GEOAPIFY_API_KEY=
VITE_GEOAPIFY_API_KEY=

# Application & Auth Settings
JWT_SECRET=nightwise-dev-jwt-secret-key-change-in-production-2026
DEMO_MODE=true
PORT=8080
ADMIN_TOKEN=nightwise-admin-secret-2026
